        <mxCell id="dor_subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#4A5D8F;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;A ticket is Ready when, in Jira, it has been created and defined as follows:&lt;/font&gt;" vertex="1">
          <mxGeometry height="20" width="700" x="200" y="222" as="geometry" />
        </mxCell>
        <mxCell id="dor_b1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;spacingTop=0;spacing=0;spacingBottom=-1;spacingLeft=-1;" value="&lt;span style=&quot;font-size: 16px; background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215));&quot;&gt;• Title and description are clear and meaningful&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 16px; background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215));&quot;&gt;• Story is assigned to an Epic&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 16px; background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215));&quot;&gt;• Acceptance criteria are defined, measurable and verifiable&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 16px; background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215));&quot;&gt;• Story points have been estimated&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 16px; background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215));&quot;&gt;• For UI stories: mockup or sketch is available, or explicitly not required&lt;/span&gt;&lt;br&gt;&lt;font style=&quot;background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215)); font-size: 16px;&quot;&gt;• Discussed in Sprint Planning and&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(26, 26, 26), rgb(215, 215, 215)); font-size: 16px;&quot;&gt;defined as &quot;Ready&quot; by the team&lt;/span&gt;" vertex="1">
          <mxGeometry height="137" width="600" x="200" y="260" as="geometry" />
        </mxCell>
        <mxCell id="dec1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF1E4;strokeColor=#B5651D;fontSize=12;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;All DoR criteria&lt;br&gt;satisfied?&lt;/font&gt;" vertex="1">
