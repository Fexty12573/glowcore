        <mxCell id="dor_header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;fontColor=#4A5D8F;letterSpacing=1.5;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;DEFINITION OF READY&lt;/font&gt;" vertex="1">
