        <mxCell id="dod_b1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1A1A1A;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;• All acceptance criteria are met&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;• Code guidelines are followed&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;• Merged into dev via Pull Request&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;• PR has ≥ 1 approval (not from the author)&lt;/font&gt;&lt;/div&gt;" vertex="1">
